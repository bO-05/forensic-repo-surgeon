{
  "name": "forensic-repo-surgeon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "surgeon": "tsx packages/cli/src/index.ts",
    "demo": "tsx packages/cli/src/index.ts demo",
    "demo:live-opus": "tsx packages/cli/src/index.ts demo --live-opus",
    "stage:cockpit": "tsx scripts/deploy-cockpit.ts --stage-only",
    "deploy:cockpit": "tsx scripts/deploy-cockpit.ts --deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run-tests.ts",
    "verify:source": "pnpm typecheck && pnpm test && pnpm surgeon intake --case cases/cypress-realworld-mobile-date-range-drawer.case.json && pnpm surgeon intake --case cases/cypress-realworld-mobile-onboarding-dialog.case.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.6.6"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@anthropic-ai/sdk": "^0.91.1",
    "fflate": "0.8.3"
  }
}
