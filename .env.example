# Copy this file to .env.local and fill values locally.
# Never commit .env.local.

# Optional live Anthropic reasoner. If omitted, the app uses deterministic fallback.
ANTHROPIC_API_KEY=
SURGEON_REASONER_PROVIDER=auto
SURGEON_REASONER_MODEL=claude-opus-4-7

# Optional target overrides. Defaults are under ./.surgeon-targets.
SURGEON_TARGET_ROOT=
SURGEON_TARGET_REPO=
SURGEON_TARGET_LOG_DIR=
SURGEON_NODE_DIR=
